# ==============================================================================
# AI-MemoryVerse — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=AI-MemoryVerse
APP_ENV=development # development | staging | production
DEBUG=true
LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=change-this-to-a-super-secret-random-hex-key-minimum-32-chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE SETTINGS (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memoryverse
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/memoryverse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# BACKGROUND QUEUE & CACHE (Redis / Render Key Value)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# AI PROVIDERS CONFIGURATION
# ------------------------------------------------------------------------------
# Available providers: mock | openai | gemini | anthropic | ollama
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini # or gemini-1.5-flash, claude-3-5-sonnet-20241022, etc.

EMBEDDING_PROVIDER=mock # mock | openai | gemini | ollama
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small # or text-embedding-004
EMBEDDING_DIMENSIONS=1536

VISION_PROVIDER=mock # mock | openai | gemini
SPEECH_PROVIDER=mock # mock | whisper | openai

# ------------------------------------------------------------------------------
# STORAGE CONFIGURATION (S3-Compatible Object Storage / Local Dev Fallback)
# ------------------------------------------------------------------------------
# Available providers: local | s3 | minio | r2
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=memoryverse-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_PATH=./storage/uploads

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_SAMESITE=lax # lax | strict | none
COOKIE_DOMAIN=

EMAIL_PROVIDER=mock # mock | sendgrid | resend | smtp
EMAIL_API_KEY=
EMAIL_FROM=noreply@memoryverse.ai

# ------------------------------------------------------------------------------
# BILLING & SAAS SETTINGS (Sandbox / Live)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=sandbox # sandbox | stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AI-MemoryVerse
NEXT_PUBLIC_APP_ENV=development
